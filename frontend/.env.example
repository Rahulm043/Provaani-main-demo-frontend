# Frontend-only environment variables
# Copy this file to .env.local for local development.

# Backend API base URL. Use your deployed VPS backend or a local backend.
VITE_API_BASE=https://api-provaani-bcrec.progressive-digital.xyz

# Supabase project used for browser login. Use the anon/publishable key only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Do NOT put backend secrets here:
# - SUPABASE_SERVICE_KEY
# - VOBIZ_AUTH_TOKEN
# - GOOGLE_API_KEY
# - OPENAI_API_KEY
